<Window x:Class="HS2Tools.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统设置" Width="720" Height="560"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="系统设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"
                       Foreground="{DynamicResource ForegroundBrush}"/>

            <!-- 代理设置 -->
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="代理设置" Style="{StaticResource CardTitle}"/>

                    <TextBlock Text="代理服务器地址" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ProxyAddress, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" VerticalContentAlignment="Center"/>
                    <TextBlock Text="{Binding ProxyError}" Foreground="{DynamicResource ErrorBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasProxyError, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="格式如 http://127.0.0.1:7890，留空则不使用代理" Margin="0,4,0,0"
                               Style="{StaticResource HintText}"/>

                    <!-- 用户名/密码仅在有代理地址时显示（照原版条件渲染） -->
                    <StackPanel Visibility="{Binding HasProxyAddress, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="用户名" Margin="0,10,0,4" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding ProxyUsername, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" VerticalContentAlignment="Center"/>
                        <TextBlock Text="如果代理需要认证，请输入用户名" Margin="0,4,0,0"
                                   Style="{StaticResource HintText}"/>

                        <TextBlock Text="密码" Margin="0,10,0,4" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox x:Name="ProxyPasswordBox" Padding="6,4" VerticalContentAlignment="Center"
                                     PasswordChanged="ProxyPasswordBox_PasswordChanged"/>
                        <TextBlock Text="如果代理需要认证，请输入密码" Margin="0,4,0,0"
                                   Style="{StaticResource HintText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 电源管理 -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="电源管理" Style="{StaticResource CardTitle}"/>
                    <CheckBox Content="阻止 Windows 休眠" IsChecked="{Binding PreventSleep}"
                              Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBlock Text="开启后，在应用运行时将阻止系统进入休眠状态（即时生效）" Margin="0,6,0,0"
                               Style="{StaticResource HintText}"/>
                </StackPanel>
            </Border>

            <!-- 操作按钮 -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="保存设置" Command="{Binding SaveCommand}" Padding="20,6"/>
                    <Button Content="重置" Command="{Binding ResetCommand}" Padding="20,6" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{DynamicResource SuccessBrush}"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
