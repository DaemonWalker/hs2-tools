<Window x:Class="HS2Tools.Views.SceneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HS2Tools.Controls"
        Title="场景库" Width="1100" Height="760"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <TabControl Margin="12">
        <!-- 场景库 -->
        <TabItem Header="场景库">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="场景管理" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    <TextBox Grid.Column="1" x:Name="SearchBox" Width="240" HorizontalAlignment="Center"
                             Padding="6,4" VerticalContentAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource SecondaryText}">
                            <Run Text="共 "/><Run Text="{Binding TotalCount, ElementName=Grid, Mode=OneWay}"/><Run Text=" 个场景"/>
                        </TextBlock>
                        <Button Content="刷新" Padding="12,4" Click="Refresh_Click"/>
                        <ComboBox x:Name="SortBox" Width="110" Margin="8,0,0,0" Padding="4,2"
                                  SelectedValuePath="Tag" SelectedIndex="0">
                            <ComboBoxItem Content="收藏优先" Tag="{x:Static controls:CardSortType.Favorite}"/>
                            <ComboBoxItem Content="名称 A-Z" Tag="{x:Static controls:CardSortType.NameAsc}"/>
                            <ComboBoxItem Content="名称 Z-A" Tag="{x:Static controls:CardSortType.NameDesc}"/>
                            <ComboBoxItem Content="路径排序" Tag="{x:Static controls:CardSortType.Path}"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <controls:CardGridControl x:Name="Grid" Grid.Row="1"
                                          CardKind="Scene"
                                          ItemsSource="{Binding AllPaths}"
                                          SelectedPath="{Binding SelectedPath, Mode=TwoWay}"
                                          SearchText="{Binding Text, ElementName=SearchBox}"
                                          EmptyText="{Binding EmptyText}"
                                          SortType="{Binding SelectedValue, ElementName=SortBox}"/>

                <Border Grid.Row="2" Margin="0,8,0,0" Padding="12" CornerRadius="8" Height="300"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <controls:CardDetailPanel DataContext="{Binding Detail}"/>
                </Border>
            </Grid>
        </TabItem>

        <!-- 智能整理 -->
        <TabItem Header="智能整理" DataContext="{Binding Organize}">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：新建任务 + 统计 -->
                <StackPanel Margin="0,0,12,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="新建整理任务" FontWeight="SemiBold" Margin="0,0,0,8"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="角色名称（每行一个）" Style="{StaticResource SecondaryText}"
                                       FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CharInput, UpdateSourceTrigger=PropertyChanged}"
                                     Height="100" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" Padding="6,4"/>
                            <TextBlock Text="目标文件夹名称（hs_tools_ 前缀自动添加）" Style="{StaticResource SecondaryText}"
                                       FontSize="12" Margin="0,10,0,4" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding FolderInput, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="6,4"/>
                            <Button Content="添加到任务列表" Margin="0,10,0,0" Padding="10,5"
                                    Command="{Binding AddTaskCommand}"/>
                            <TextBlock Text="系统会自动扫描所有场景文件，将包含指定角色的场景移动到目标文件夹中。"
                                       Style="{StaticResource SecondaryText}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="总任务" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                <TextBlock Text="{Binding Tasks.Count, StringFormat={}{0}}"
                                           FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="已完成" Style="{StaticResource SecondaryText}" FontSize="12"/>
                                <TextBlock Text="{Binding CompletedCount, StringFormat={}{0}}"
                                           FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 右：任务列表 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="执行所有任务" Padding="12,4" Command="{Binding ExecuteAllCommand}"/>
                        <Button Content="清空列表" Padding="12,4" Margin="8,0,0,0" Command="{Binding ClearCommand}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="暂无整理任务：在左侧添加角色名称和文件夹名称来创建任务"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Tasks}" BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="12" CornerRadius="8"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource ForegroundBrush}"/>
                                                <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0"
                                                           VerticalAlignment="Center" FontSize="12"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="执行此任务" Padding="8,2" FontSize="11" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ExecuteTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="删除" Padding="8,2" FontSize="11"
                                                        Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding CharNamesText}" Margin="0,6,0,0" FontSize="12"
                                                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>

                                        <StackPanel Margin="0,6,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Progress}"/>
                                            <TextBlock Text="{Binding ProgressText}" FontSize="11" Margin="0,4,0,0"
                                                       Style="{StaticResource SecondaryText}"/>
                                        </StackPanel>

                                        <TextBlock FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SuccessBrush}">
                                            <Run Text="{Binding ResultCount, StringFormat='成功整理 {0} 个场景到 ', Mode=OneWay}"/><Run Text="{Binding FolderName, StringFormat='hs_tools_{0}', Mode=OneWay}"/><Run Text="{Binding MoveFailText, Mode=OneWay}"/>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource ErrorBrush}"
                                                   Text="{Binding Error}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
