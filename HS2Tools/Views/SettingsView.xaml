<UserControl x:Class="HS2Tools.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,26,28,28" MaxWidth="900">
            <TextBlock Text="系统设置" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="配置网络代理与应用运行行为" Style="{StaticResource PageSubtitle}" Margin="0,5,0,24"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="网络代理" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="下载和 Sideload 更新将通过此处配置的网络连接"
                               Style="{StaticResource HintText}" Margin="0,4,0,18"/>
                    <TextBlock Text="代理服务器地址" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ProxyAddress, UpdateSourceTrigger=PropertyChanged}"
                             Tag="http://127.0.0.1:7890"/>
                    <TextBlock Text="{Binding ProxyError}" Foreground="{DynamicResource ErrorBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasProxyError, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="支持 http、https、socks5；留空则直接连接" Margin="0,6,0,0"
                               Style="{StaticResource HintText}"/>
                    <StackPanel Visibility="{Binding HasProxyAddress, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="用户名" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ProxyUsername, UpdateSourceTrigger=PropertyChanged}" Tag="可选"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="ProxyPasswordBox" PasswordChanged="ProxyPasswordBox_PasswordChanged"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="电源管理" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="控制应用运行期间的系统休眠行为"
                               Style="{StaticResource HintText}" Margin="0,4,0,16"/>
                    <CheckBox Content="阻止 Windows 休眠" IsChecked="{Binding PreventSleep}"/>
                    <TextBlock Text="开启后立即生效，并在下次启动应用时自动恢复"
                               Style="{StaticResource HintText}" Margin="26,7,0,0"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="保存设置" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Padding="22,8"/>
                    <Button Content="重置" Command="{Binding ResetCommand}" Padding="22,8" Margin="10,0,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource SuccessSoftBrush}"
                        CornerRadius="6" Padding="10,7"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}"/>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
