<Window x:Class="HS2Tools.Views.SimilarModMatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="相近 Mod 匹配" Width="1280" Height="720" MinWidth="1000" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="相近 Mod 匹配" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                       Text="仅在本地和 Sideload 均无精确 GUID 时生成候选。勾选用户确认的匹配；同一需要 GUID 同时只能选择一个候选。"/>
            <Border Style="{StaticResource Card}" Margin="0,14,0,16" Padding="12">
                <TextBlock Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                           Text="只改写副本或下载文件的 GUID，不修改原始本地 Mod，也不保证不同修订号的内容兼容。所有候选默认不选择。"/>
            </Border>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding SimilarModMatchItems}"
                  AutoGenerateColumns="False" IsReadOnly="False"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选择" Width="55"
                                        Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="需要的 GUID" Binding="{Binding RequiredGuid}" Width="170" IsReadOnly="True"/>
                <DataGridTextColumn Header="候选 GUID" Binding="{Binding CandidateGuid}" Width="170" IsReadOnly="True"/>
                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="匹配依据" Binding="{Binding MatchDescription}" Width="190" IsReadOnly="True"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="执行操作" Binding="{Binding Operation}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="本地路径 / Sideload 地址" Binding="{Binding Location}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Text="{Binding SimilarModMatchCount, StringFormat='共 {0} 条候选'}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="关闭" Click="CloseButton_Click"/>
                <Button x:Name="ConfirmButton" Content="执行选中匹配" Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0" Click="ConfirmButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
