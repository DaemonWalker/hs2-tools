<UserControl x:Class="HS2Tools.Views.CardExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="OverlayText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        </Style>
        <DataTemplate x:Key="ModListTemplate">
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="16,14,16,12">
                        <TextBlock Text="模组依赖" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{Binding ModCount, StringFormat=' ({0})'}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <TextBlock Text="{Binding ModLocalCount, StringFormat='已拥有 {0}'}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="{Binding ModMissingCount, StringFormat='需下载 {0}'}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" FontSize="12" Foreground="{DynamicResource WarningBrush}"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding ModItems}" Margin="8,0,8,8"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Guid}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Guid}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource WarningBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocal}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="未检测到模组依赖">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource OverlayText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding ModCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,26,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="单卡查看" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="直接打开 PNG 卡片，检查预览、角色信息与模组依赖" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,16" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="7" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="人物卡" IsChecked="{Binding IsCharaMode}" Style="{StaticResource SegmentedRadioButton}"/>
                        <RadioButton Content="场景卡" IsChecked="{Binding IsSceneMode}" Style="{StaticResource SegmentedRadioButton}"/>
                    </StackPanel>
                </Border>
                <TextBox Grid.Column="1" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                         Tag="输入 PNG 卡片完整路径" Margin="12,0,0,0"/>
                <Button Grid.Column="2" Content="清除" Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                        Command="{Binding ClearFileCommand}"
                        Visibility="{Binding HasFilePath, Converter={StaticResource BoolToVisibility}}"/>
                <Button Grid.Column="3" Content="浏览文件" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                        Command="{Binding BrowseCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="52" Height="52" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="选择一个 PNG 卡片文件" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0"/>
                <TextBlock Text="点击「浏览文件」，或直接输入卡片完整路径" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="180"/>
                <TextBlock Text="正在解析卡片…" Margin="0,12,0,0" Style="{StaticResource OverlayText}"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" FontSize="14" TextWrapping="Wrap" Margin="40,0"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ErrorBrush}"/>
        </Border>

        <Grid Grid.Row="2" Visibility="{Binding ShowContent, Converter={StaticResource BoolToVisibility}}">
            <Grid Visibility="{Binding IsCharaMode, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <Image Source="{Binding CardImage}" Stretch="Uniform"/>
                        <TextBlock Text="暂无预览">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource OverlayText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CardImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Margin="16,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="角色信息" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="名称" Foreground="{DynamicResource SecondaryForegroundBrush}"/><TextBlock Grid.Column="1" Text="{Binding CharaName}" FontWeight="SemiBold" TextWrapping="Wrap"/></Grid>
                            <Grid Margin="0,3" Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="描述" Foreground="{DynamicResource SecondaryForegroundBrush}"/><TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap"/></Grid>
                            <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="游戏数据" Foreground="{DynamicResource SecondaryForegroundBrush}"/><TextBlock Grid.Column="1" Text="{Binding GameDataSizeText}"/></Grid>
                        </StackPanel>
                    </Border>
                    <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ModListTemplate}"/>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding IsSceneMode, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="45*"/><ColumnDefinition Width="55*"/></Grid.ColumnDefinitions>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="55*"/><RowDefinition Height="45*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,16">
                        <Grid><Image Source="{Binding CardImage}" Stretch="Uniform"/><TextBlock Text="暂无预览"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource OverlayText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CardImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Margin="16,14,16,10">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="场景人物" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding SceneCharaCount, StringFormat=' ({0} 个)'}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/></StackPanel>
                                <TextBlock Text="{Binding GameDataSizeText, StringFormat='游戏数据：{0}'}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                            </StackPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding SceneCharaNames}" Margin="8,0,8,8" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="5" Padding="10,7" Margin="0,0,0,4"><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="1" Text="未检测到场景人物"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource OverlayText}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SceneCharaCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Grid>
                    </Border>
                </Grid>
                <ContentControl Grid.Column="1" Margin="16,0,0,0" Content="{Binding}" ContentTemplate="{StaticResource ModListTemplate}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
