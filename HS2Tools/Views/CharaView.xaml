<UserControl x:Class="HS2Tools.Views.CharaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HS2Tools.Controls">
    <Grid Margin="28,26,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="角色卡" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="浏览收藏、检查模组依赖并补全缺失内容" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,6" CornerRadius="6"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}">
                    <Run Text="共 "/><Run Text="{Binding TotalCount, ElementName=Grid, Mode=OneWay}"/><Run Text=" 个角色"/>
                </TextBlock>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,16" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Tag="搜索角色名称或文件路径" MaxWidth="440"
                         HorizontalAlignment="Left" Width="360"/>
                <ComboBox Grid.Column="1" x:Name="SortBox" Width="132" Margin="10,0,0,0"
                          SelectedValuePath="Tag" SelectedIndex="0">
                    <ComboBoxItem Content="收藏优先" Tag="{x:Static controls:CardSortType.Favorite}"/>
                    <ComboBoxItem Content="名称 A-Z" Tag="{x:Static controls:CardSortType.NameAsc}"/>
                    <ComboBoxItem Content="名称 Z-A" Tag="{x:Static controls:CardSortType.NameDesc}"/>
                    <ComboBoxItem Content="路径排序" Tag="{x:Static controls:CardSortType.Path}"/>
                </ComboBox>
                <Button Grid.Column="2" Content="刷新" Margin="8,0,0,0" Click="Refresh_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*" MinWidth="420"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="{Binding DataContext.HasSelection, Source={x:Reference Grid}, Converter={StaticResource BoolToStarGridLength}}"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12,10,8,10" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="目录" Style="{StaticResource SectionTitle}" Margin="4,0,0,10"/>
                    <TreeView Grid.Row="1" ItemsSource="{Binding Directories}"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" Margin="2,3"/>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <controls:CardGridControl Grid.Column="2" x:Name="Grid"
                                      CardKind="Chara"
                                      ItemsSource="{Binding AllPaths}"
                                      SelectedPath="{Binding SelectedPath, Mode=TwoWay}"
                                      SearchText="{Binding Text, ElementName=SearchBox}"
                                      EmptyText="{Binding EmptyText}"
                                      SortType="{Binding SelectedValue, ElementName=SortBox}"/>
            <GridSplitter Grid.Column="3" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"/>
            <Border Grid.Column="4" Margin="6,0,0,0" Padding="16" CornerRadius="10"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                <controls:CardDetailPanel DataContext="{Binding Detail}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
