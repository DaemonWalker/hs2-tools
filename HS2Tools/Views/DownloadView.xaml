<UserControl x:Class="HS2Tools.Views.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="TaskItemTemplate">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"/>
                        <ProgressBar Value="{Binding Percent}" Margin="0,9,0,7"
                                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="12"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Content="取消" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                            Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}"/>
                    <Button Grid.Column="1" Content="重试" VerticalAlignment="Center"
                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding ShowRetry, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="TaskList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemTemplate" Value="{StaticResource TaskItemTemplate}"/>
        </Style>
        <Style x:Key="EmptyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,26,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="下载任务" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="管理下载进度、失败重试与后台任务" Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="全部取消" Command="{Binding CancelAllCommand}"
                        Visibility="{Binding ShowCancelAll, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="清除完成" Command="{Binding ClearFinishedCommand}" Margin="8,0,0,0"
                        Visibility="{Binding ShowClearFinished, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,20,0,16">
            <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="活跃任务" Style="{StaticResource StatTitle}"/>
                    <TextBlock Text="{Binding ActiveCount, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}"
                               Foreground="{DynamicResource AccentBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="失败任务" Style="{StaticResource StatTitle}"/>
                    <TextBlock Text="{Binding FailedCount, StringFormat={}{0:N0}}" Style="{StaticResource StatValue}"
                               Foreground="{DynamicResource ErrorBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCard}">
                <StackPanel>
                    <TextBlock Text="总速度" Style="{StaticResource StatTitle}"/>
                    <TextBlock Text="{Binding TotalSpeedText}" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TabControl Grid.Row="3">
            <TabItem>
                <TabItem.Header><TextBlock Text="{Binding TotalCount, StringFormat='全部 ({0})'}"/></TabItem.Header>
                <Grid>
                    <ListBox ItemsSource="{Binding AllTasks}" Style="{StaticResource TaskList}"/>
                    <TextBlock Text="暂无下载任务" Style="{StaticResource EmptyText}"
                               Visibility="{Binding IsAllEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header><TextBlock Text="{Binding ActiveCount, StringFormat='下载中 ({0})'}"/></TabItem.Header>
                <Grid>
                    <ListBox ItemsSource="{Binding ActiveTasks}" Style="{StaticResource TaskList}"/>
                    <TextBlock Text="没有正在下载的任务" Style="{StaticResource EmptyText}"
                               Visibility="{Binding IsActiveEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header><TextBlock Text="{Binding CompletedCount, StringFormat='已完成 ({0})'}"/></TabItem.Header>
                <Grid>
                    <ListBox ItemsSource="{Binding CompletedTasks}" Style="{StaticResource TaskList}"/>
                    <TextBlock Text="没有已完成的任务" Style="{StaticResource EmptyText}"
                               Visibility="{Binding IsCompletedEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header><TextBlock Text="{Binding FailedCount, StringFormat='失败 ({0})'}"/></TabItem.Header>
                <Grid>
                    <ListBox ItemsSource="{Binding FailedTasks}" Style="{StaticResource TaskList}"/>
                    <TextBlock Text="没有失败的任务" Style="{StaticResource EmptyText}"
                               Visibility="{Binding IsFailedEmpty, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Margin="0,14,0,0" Padding="12,8" CornerRadius="7"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <TextBlock Text="下载目录：mods/hs2-tool-download" FontSize="12"
                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                <TextBlock Text="{Binding TotalSpeedText, StringFormat='总速度：{0}'}" FontSize="12"
                           HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"
                           Visibility="{Binding ShowCancelAll, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
