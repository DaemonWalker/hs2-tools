<Window x:Class="HS2Tools.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HS2 Tools" Width="1020" Height="800"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- 卡片容器样式：全主题单例，颜色一律 DynamicResource -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="HS2 角色信息查看器" FontSize="26" FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundBrush}"/>
                <TextBlock Text="一站式管理你的 Honey Select 2 角色卡、场景和模组" Margin="0,2,0,16"
                           Style="{StaticResource SecondaryText}"/>
            </StackPanel>

            <!-- 第一行：数据分析 + 快速启动 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                    <StackPanel>
                        <TextBlock Text="数据分析" Style="{StaticResource CardTitle}"/>
                        <Button Content="{Binding ScanButtonText}" Command="{Binding ScanCommand}"
                                Padding="12,8" FontSize="14"/>
                        <StackPanel Margin="0,10,0,0">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="1. 分析 Mods" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text=" ✓" Foreground="{DynamicResource SuccessBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ModScanDone}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ModScanProgress}" Style="{StaticResource SecondaryText}"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="2. 分析场景" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text=" ✓" Foreground="{DynamicResource SuccessBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SceneScanDone}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SceneScanProgress}" Style="{StaticResource SecondaryText}"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="3. 分析角色" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text=" ✓" Foreground="{DynamicResource SuccessBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CharaScanDone}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding CharaScanProgress}" Style="{StaticResource SecondaryText}"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding ScanError}" Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Text="首次使用或数据更新后，建议先执行分析" Margin="0,8,0,0"
                                   Style="{StaticResource SecondaryText}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,12">
                    <StackPanel>
                        <TextBlock Text="快速启动" Style="{StaticResource CardTitle}"/>
                        <Button Content="开始游戏" Command="{Binding LaunchGameCommand}"
                                Padding="12,10" FontSize="15" FontWeight="SemiBold"/>
                        <Button Content="开始工作室" Command="{Binding LaunchStudioCommand}"
                                Padding="12,10" FontSize="14" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding LaunchStatusText}" Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 第二行：数据初始化 + 数据概览 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Margin="0,0,6,12">
                    <StackPanel>
                        <TextBlock Text="数据初始化" Style="{StaticResource CardTitle}"/>
                        <Button Content="{Binding SideloaderButtonText}" Command="{Binding ToggleSideloaderCommand}"
                                Padding="12,8" FontSize="14"/>

                        <StackPanel Visibility="{Binding IsSideloaderRunning, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,8,0,0">
                            <TextBlock Text="正在分析：" Style="{StaticResource SecondaryText}" FontSize="12"/>
                            <TextBlock Text="{Binding SideloaderMessage}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SideloaderMessage}" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text="{Binding SideloaderFoundCount, StringFormat='已发现 {0} 个'}"
                                       Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock Visibility="{Binding SideloaderSucceeded, Converter={StaticResource BoolToVisibility}}"
                                   Text="{Binding SideloaderMessage}" Foreground="{DynamicResource SuccessBrush}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Visibility="{Binding SideloaderStopped, Converter={StaticResource BoolToVisibility}}"
                                   Text="已停止：更新任务已被取消" Foreground="{DynamicResource WarningBrush}"
                                   Margin="0,8,0,0"/>
                        <TextBlock Visibility="{Binding SideloaderFailed, Converter={StaticResource BoolToVisibility}}"
                                   Text="{Binding SideloaderError, StringFormat='更新失败：{0}'}" Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="从 sideload.betterrepack.com 获取最新的 Mod 信息，用于自动补全缺失的 Mods"
                                   Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <Separator Margin="0,12"/>

                        <TextBlock Text="所有 Mods 已就绪，当前没有需要补全的缺失 Mods"
                                   Foreground="{DynamicResource SuccessBrush}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowModsReady}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Content="{Binding ComplementButtonText}" Command="{Binding ComplementMissingModsCommand}"
                                Padding="12,8" FontSize="14">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMissingMods}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <StackPanel Visibility="{Binding IsComplementing, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,8,0,0">
                            <TextBlock Text="{Binding ComplementProgress, StringFormat='总体进度：{0}'}"
                                       Style="{StaticResource SecondaryText}" FontSize="12"/>
                            <TextBlock Text="{Binding ComplementCurrentName, StringFormat='当前：{0}'}"
                                       Style="{StaticResource SecondaryText}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ComplementCurrentName}"/>
                        </StackPanel>
                        <TextBlock Text="检测到角色/场景依赖但本地缺失的 Mods 时，可一键自动下载补全"
                                   Style="{StaticResource SecondaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,12">
                    <StackPanel>
                        <TextBlock Text="数据概览" Style="{StaticResource CardTitle}"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="本地 Mods" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding ModCount, StringFormat={}{0:N0}}"
                                       FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="被引用 Mods" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding UsageCount, StringFormat={}{0:N0}}"
                                       FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="总引用次数" Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalRefs, StringFormat={}{0:N0}}"
                                       FontWeight="Bold" FontSize="18" Foreground="{DynamicResource ForegroundBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 游戏路径设置 -->
            <Border Grid.Row="3" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="游戏路径" Style="{StaticResource CardTitle}"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="浏览…" Margin="8,0,0,0" Padding="16,4"
                                Command="{Binding BrowseCommand}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource ErrorBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGamePathValid}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding PathStatusText}" Style="{StaticResource SecondaryText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 页面导航 -->
            <UniformGrid Grid.Row="4" Columns="4">
                <Button Content="角色卡浏览" Margin="6" Padding="12" Click="NavChara_Click"/>
                <Button Content="场景库" Margin="6" Padding="12" Click="NavScene_Click"/>
                <Button Content="单卡查看" Margin="6" Padding="12" Click="NavCardExplorer_Click"/>
                <Button Content="本地模组" Margin="6" Padding="12" Click="NavMods_Click"/>
                <Button Content="BetterRepack" Margin="6" Padding="12" Click="NavSideload_Click"/>
                <Button Content="下载任务" Margin="6" Padding="12" Click="NavDownload_Click"/>
                <Button Content="系统设置" Margin="6" Padding="12" Click="NavSettings_Click"/>
            </UniformGrid>

            <TextBlock Grid.Row="5" Text="首次使用请先在「游戏路径」中选择游戏目录，然后执行「数据分析」"
                       HorizontalAlignment="Center" Margin="0,8,0,4"
                       Style="{StaticResource SecondaryText}" FontSize="12"/>
        </Grid>
    </ScrollViewer>
</Window>
