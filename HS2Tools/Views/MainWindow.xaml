<Window x:Class="HS2Tools.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HS2 Tools" Width="1360" Height="860" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="20,24,20,26" Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="10"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="H2" Foreground="{DynamicResource OnAccentBrush}" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HS2 Tools" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="游戏内容管理器" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="概览" Margin="22,0,0,6" FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <RadioButton x:Name="NavHome" GroupName="Navigation" Style="{StaticResource NavRadioButton}"
                                     Checked="NavHome_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26"
                                           VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="工作台" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="内容库" Margin="22,22,0,6" FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <RadioButton GroupName="Navigation" Style="{StaticResource NavRadioButton}" Checked="NavChara_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26"
                                           VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="角色卡" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Navigation" Style="{StaticResource NavRadioButton}" Checked="NavScene_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26"
                                           VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="场景库" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Navigation" Style="{StaticResource NavRadioButton}" Checked="NavCardExplorer_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26"
                                           VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="单卡查看" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="模组管理" Margin="22,22,0,6" FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <RadioButton GroupName="Navigation" Style="{StaticResource NavRadioButton}" Checked="NavMods_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26"
                                           VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="本地模组" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Navigation" Style="{StaticResource NavRadioButton}" Checked="NavSideload_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26"
                                           VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Sideload 数据库" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="系统" Margin="22,22,0,6" FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <RadioButton GroupName="Navigation" Style="{StaticResource NavRadioButton}" Checked="NavDownload_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26"
                                           VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="下载任务" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton GroupName="Navigation" Style="{StaticResource NavRadioButton}" Checked="NavSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26"
                                           VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="系统设置" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Margin="16,12,16,18" Padding="12,10" CornerRadius="8"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="当前游戏" FontSize="11"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                        <ComboBox x:Name="GlobalGameSwitcher" Margin="0,7,0,0"
                                  ItemsSource="{Binding GameSwitchItems}"
                                  SelectedItem="{Binding SelectedGameSwitchItem, Mode=TwoWay}"
                                  AutomationProperties.Name="全局游戏切换">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" x:Name="PageHost"/>
    </Grid>
</Window>
