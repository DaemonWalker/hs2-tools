<UserControl x:Class="HS2Tools.Views.SceneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HS2Tools.Controls">
    <Grid Margin="28,26,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="场景库" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="浏览场景卡片，或按角色名称批量整理文件" Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="场景浏览">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Tag="搜索场景名称或文件路径" Width="360" MaxWidth="440"
                                     HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="12,0"
                                       Foreground="{DynamicResource SecondaryForegroundBrush}">
                                <Run Text="共 "/><Run Text="{Binding TotalCount, ElementName=Grid, Mode=OneWay}"/><Run Text=" 个场景"/>
                            </TextBlock>
                            <ComboBox Grid.Column="2" x:Name="SortBox" Width="132"
                                      SelectedValuePath="Tag" SelectedIndex="0">
                                <ComboBoxItem Content="收藏优先" Tag="{x:Static controls:CardSortType.Favorite}"/>
                                <ComboBoxItem Content="名称 A-Z" Tag="{x:Static controls:CardSortType.NameAsc}"/>
                                <ComboBoxItem Content="名称 Z-A" Tag="{x:Static controls:CardSortType.NameDesc}"/>
                                <ComboBoxItem Content="路径排序" Tag="{x:Static controls:CardSortType.Path}"/>
                            </ComboBox>
                            <Button Grid.Column="3" Content="刷新" Margin="8,0,0,0" Click="Refresh_Click"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="2*" MinWidth="420"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="{Binding DataContext.HasSelection, Source={x:Reference Grid}, Converter={StaticResource BoolToStarGridLength}}"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="12,10,8,10" Margin="0,0,6,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="目录" Style="{StaticResource SectionTitle}" Margin="4,0,0,10"/>
                                <TreeView Grid.Row="1" ItemsSource="{Binding Directories}"
                                          Background="Transparent" BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" Margin="2,3"/>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Grid>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <controls:CardGridControl Grid.Column="2" x:Name="Grid" CardKind="Scene"
                                                  ItemsSource="{Binding AllPaths}"
                                                  SelectedPath="{Binding SelectedPath, Mode=TwoWay}"
                                                  SearchText="{Binding Text, ElementName=SearchBox}"
                                                  EmptyText="{Binding EmptyText}"
                                                  SortType="{Binding SelectedValue, ElementName=SortBox}"/>
                        <GridSplitter Grid.Column="3" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"/>
                        <Border Grid.Column="4" Margin="6,0,0,0" Padding="16" CornerRadius="10"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <controls:CardDetailPanel DataContext="{Binding Detail}"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="智能整理" DataContext="{Binding Organize}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="新建整理任务" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="系统会扫描场景文件，将包含指定角色的场景移动到目标文件夹。"
                                               Style="{StaticResource HintText}" Margin="0,5,0,16"/>
                                    <TextBlock Text="角色名称（每行一个）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding CharInput, UpdateSourceTrigger=PropertyChanged}"
                                             Height="110" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" Tag="输入角色名称"/>
                                    <TextBlock Text="目标文件夹名称" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                                    <TextBox Text="{Binding FolderInput, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="自动添加 hs_tools_ 前缀"/>
                                    <Button Content="添加到任务列表" Margin="0,14,0,0"
                                            Style="{StaticResource PrimaryButton}" Command="{Binding AddTaskCommand}"/>
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="2" Margin="0,14,0,0">
                                <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="总任务" Style="{StaticResource StatTitle}"/>
                                        <TextBlock Text="{Binding Tasks.Count}" Style="{StaticResource StatValue}"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatCard}">
                                    <StackPanel>
                                        <TextBlock Text="已完成" Style="{StaticResource StatTitle}"/>
                                        <TextBlock Text="{Binding CompletedCount}" Style="{StaticResource StatValue}"
                                                   Foreground="{DynamicResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="整理任务" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="依次执行所有待处理任务" Style="{StaticResource HintText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="清空列表" Command="{Binding ClearCommand}"/>
                                <Button Content="执行所有任务" Command="{Binding ExecuteAllCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="暂无整理任务：请在左侧添加角色名称和文件夹名称"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Tasks}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,170,0">
                                                    <TextBlock Text="{Binding FolderName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                               FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="执行" Padding="10,5" FontSize="12" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.ExecuteTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding IsPending}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Content="删除" Padding="10,5" FontSize="12"
                                                            Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding IsPending}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding CharNamesText}" Margin="0,8,0,0" FontSize="12"
                                                       Foreground="{DynamicResource SecondaryForegroundBrush}" TextWrapping="Wrap"/>
                                            <StackPanel Margin="0,8,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <ProgressBar Value="{Binding Progress}"/>
                                                <TextBlock Text="{Binding ProgressText}" FontSize="11" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                            </StackPanel>
                                            <TextBlock FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}">
                                                <Run Text="{Binding ResultCount, StringFormat='成功整理 {0} 个场景到 ', Mode=OneWay}"/><Run Text="{Binding FolderName, StringFormat='hs_tools_{0}', Mode=OneWay}"/><Run Text="{Binding MoveFailText, Mode=OneWay}"/>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ErrorBrush}" Text="{Binding Error}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
