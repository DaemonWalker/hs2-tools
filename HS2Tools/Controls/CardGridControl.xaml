<UserControl x:Class="HS2Tools.Controls.CardGridControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HS2Tools.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="EmptyTextBlock" Text="{Binding EmptyText, ElementName=Root}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryForegroundBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TotalCount, ElementName=Root}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ItemsControl x:Name="GridItems">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer x:Name="Scroller" CanContentScroll="True"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:VirtualizingWrapPanel
                        ItemWidth="{Binding CardItemWidth, RelativeSource={RelativeSource AncestorType=controls:CardGridControl}}"
                        ItemHeight="{Binding CardItemHeight, RelativeSource={RelativeSource AncestorType=controls:CardGridControl}}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type controls:CardItemViewModel}">
                    <Border Margin="6" CornerRadius="9" BorderThickness="1" ClipToBounds="True" Cursor="Hand"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" MouseLeftButtonUp="Card_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource WindowBackgroundBrush}" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="暂无预览" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="1" Text="{Binding DisplayName}" Margin="10,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DisplayName}"/>
                            <Button Grid.RowSpan="2" Content="♥" FontSize="15" Cursor="Hand"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" MinHeight="30"
                                    Margin="0,5,5,0" Padding="7,4"
                                    ToolTip="收藏 / 取消收藏" Click="Favorite_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="FooterText" Grid.Row="1" Margin="0,8,0,0"
                   HorizontalAlignment="Center" FontSize="12"
                   Foreground="{DynamicResource SecondaryForegroundBrush}"/>
    </Grid>
</UserControl>
