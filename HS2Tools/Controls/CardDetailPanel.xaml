<UserControl x:Class="HS2Tools.Controls.CardDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Height="200" CornerRadius="8" ClipToBounds="True"
                Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid>
                <TextBlock Text="暂无预览" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" FontSize="12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DetailImage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Image Source="{Binding DetailImage}" Stretch="Uniform"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,14,0,16">
            <TextBlock Text="{Binding DetailName}" FontSize="18" FontWeight="SemiBold"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
            <TextBlock Margin="0,5,0,0" FontSize="12" TextWrapping="Wrap" MaxHeight="52"
                       Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Text="{Binding DetailDescription}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DetailDescription}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="修改时间" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <TextBlock Text="{Binding DetailModified}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="文件大小" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <TextBlock Text="{Binding DetailSize}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock Margin="0,9,0,0" FontSize="11" Foreground="{DynamicResource SecondaryForegroundBrush}"
                       Text="{Binding DetailFilePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailFilePath}"/>
            <Button Content="打开所在文件夹" Margin="0,10,0,0" Padding="10,5" HorizontalAlignment="Left"
                    Style="{StaticResource GhostButton}" Command="{Binding OpenInFolderCommand}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="模组依赖"/><Run Text="{Binding ModItems.Count, StringFormat=' ({0})', Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Foreground="{DynamicResource SuccessBrush}" FontSize="12"
                                   Text="{Binding LocalCount, StringFormat='已拥有 {0}'}"/>
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Text="{Binding MissingCount, StringFormat='缺少 {0}'}"/>
                    </StackPanel>
                </StackPanel>
                <Button Padding="9,5" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Content="{Binding MissingCount, StringFormat='下载缺失 ({0})'}"
                        Command="{Binding DownloadAllMissingCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MissingCount}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <ListBox Grid.Row="1" ItemsSource="{Binding ModItems}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="6"
                                Padding="10,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Guid}" VerticalAlignment="Center" Margin="0,0,8,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Guid}" FontSize="12"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDownloading}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <ProgressBar Width="64" Height="5" Value="{Binding Percent}"/>
                                    <Button Content="取消" Padding="6,2" Margin="6,0,0,0" FontSize="11" MinHeight="26"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.CancelModCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="已完成" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource SuccessBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding ShowCompleted}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="已拥有" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource SuccessBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding ShowOwned}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="1" Content="下载" Padding="8,3" FontSize="11" MinHeight="28"
                                        Command="{Binding DataContext.DownloadModCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding ShowDownload}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Grid.Column="1" Content="不可用" Padding="8,3" FontSize="11" MinHeight="28" IsEnabled="False">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding ShowUnavailable}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="1" Text="未检测到模组依赖" HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource SecondaryForegroundBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ModItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
